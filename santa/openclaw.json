{
  "agents": {
    "defaults": {
      "model": {
        "primary": "cerebras/moonshotai-kimi-k3.1-pro-trial"
      },
      "thinkingDefault": "low",
      "workspace": "~/santa/workspace"
    }
  },
  "tools": {
    "profile": "minimal",
    "alsoAllow": [
      "web_fetch"
    ],
    "web": {
      "fetch": {
        "cacheTtlMinutes": 0
      }
    },
    "toolSearch": false
  },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "api": "openai-completions",
        "apiKey": "${CEREBRAS_API_KEY}",
        "models": [
          {
            "id": "moonshotai-kimi-k3.1-pro-trial",
            "name": "Kimi K3.1 Pro (Cerebras)",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsStrictMode": false,
              "supportsReasoningEffort": true,
              "supportedReasoningEfforts": [
                "low",
                "high",
                "max"
              ]
            }
          }
        ]
      }
    }
  }
}
