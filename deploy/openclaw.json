{
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "model": {
        "primary": "cerebras/moonshotai-kimi-k3.1-pro-trial"
      },
      "thinkingDefault": "low",
      "maxConcurrent": 16
    },
    "entries": {
      "livelab-finder": {
        "workspace": "~/livelab/agents/finder",
        "tools": {
          "profile": "minimal",
          "deny": [
            "session_status",
            "gateway"
          ]
        }
      },
      "livelab-builder": {
        "workspace": "~/livelab/agents/builder",
        "tools": {
          "profile": "minimal",
          "deny": [
            "session_status",
            "gateway"
          ]
        }
      }
    }
  },
  "tools": {
    "toolSearch": false
  },
  "gateway": {
    "mode": "local",
    "port": 18790,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "terminal": {
      "enabled": false
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "api": "openai-completions",
        "apiKey": "${CEREBRAS_API_KEY}",
        "models": [
          {
            "id": "moonshotai-kimi-k3.1-pro-trial",
            "name": "Kimi K3.1 Pro (Cerebras)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsStrictMode": false,
              "supportsReasoningEffort": true,
              "supportedReasoningEfforts": [
                "low",
                "high",
                "max"
              ]
            }
          }
        ]
      }
    }
  }
}
